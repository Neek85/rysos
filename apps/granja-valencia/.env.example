# Supabase — variables públicas expuestas al cliente Expo (prefijo
# EXPO_PUBLIC_ requerido: es lo único que Expo inlinea en el bundle,
# confirmado contra https://docs.expo.dev/guides/environment-variables/).
# NUNCA poner la Service Role Key acá -- este archivo (y cualquier
# EXPO_PUBLIC_*) queda visible en texto plano en el binario compilado.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
